# Server secrets only. Never use NEXT_PUBLIC_ for any credential.
OPENAI_API_KEY=
# Lifetime application estimate cap; maximum 5, default 3.00 (safety margin).
AI_BUDGET_USD=3
# Production/serverless: durable Redis shared across all deployments/workers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative only for a persistent shared filesystem (NOT /tmp or serverless disk):
# AI_STATE_DIR=/persistent-volume/shadowui-ai
# Development defaults to .shadowui/ai. Never delete ledger to reset billing.
