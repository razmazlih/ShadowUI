# Server secrets only. Never use NEXT_PUBLIC_ for any credential.
OPENAI_API_KEY=
# Lifetime application estimate cap; maximum 5, default 3.00 (safety margin).
AI_BUDGET_USD=3
# Production/serverless: durable Redis shared across all deployments/workers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative only for a persistent shared filesystem (NOT /tmp or serverless disk):
# AI_STATE_DIR=/persistent-volume/shadowui-ai
# Development defaults to .shadowui/ai. Never delete ledger to reset billing.

# Firestore catalog. All credentials stay on the server.
FIREBASE_PROJECT_ID=shadowui-razmaz
FIREBASE_ADMIN_EMAIL=
# Hosted secret: full service-account JSON (never NEXT_PUBLIC_).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative local credential path:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Explicit local emulators; never configure these on the hosted deployment:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# CATALOG_EMULATOR_ADMIN_TOKEN=local-test-only
# Firebase web configuration is public; it contains no service-account key.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shadowui-razmaz.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shadowui-razmaz
NEXT_PUBLIC_FIREBASE_APP_ID=
